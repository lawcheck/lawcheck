# Образец окружения. Скопировать в .env и заполнить.
# Пустое значение = функция выключена, полный список — lawcheck/config.py.

# === База и очередь ===
# По умолчанию sqlite в текущей директории — для dev.
# В проде DATABASE_URL и REDIS_URL проставляет docker-compose.
DATABASE_URL=sqlite:///lawcheck.db
# Пусто = задачи идут через FastAPI BackgroundTasks (dev-режим).
REDIS_URL=

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
SITE_BASE_URL=https://lawchek.ru

# === Сессии аккаунтов (в проде заполнить обязательно) ===
# Пусто — секрет генерируется эфемерно, и все сессии слетают при рестарте
# контейнера. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# === Краулер ===
CRAWLER_MAX_PAGES=30
CRAWLER_TIMEOUT_SEC=30
CRAWLER_USER_AGENT=LawCheckBot/0.1 (+https://lawchek.ru/bot)

# === Эквайринг Точки ===
# Пока TOCHKA_JWT пуст — оплата работает в fallback-режиме (заявка на email).
TOCHKA_JWT=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
TOCHKA_BASE_URL=https://enter.tochka.com/uapi

# === Внутренние ручки (мониторинг и письма-догонялки по cron) ===
# Пусто = /internal/* закрыты для всех. Сгенерировать: openssl rand -hex 32
INTERNAL_KEY=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_BOT_USERNAME=LawCheckMonitor_bot
# Заполнить обязательно, если бот используется: пустой секрет закрывает
# /webhooks/telegram наглухо. Тем же значением регистрируется вебхук:
# setWebhook?secret_token=...
TELEGRAM_WEBHOOK_SECRET=

# === Почта ===
# SMTP_HOST пуст — письма не уходят по сети, а печатаются в лог (dev-режим).
# Порт 465 → SMTP_SSL, иначе SMTP + STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LawCheck <noreply@lawchek.ru>
SMTP_STARTTLS=true
# Заполнять, ТОЛЬКО когда ящик реально заведён: Reply-To на несуществующий
# адрес хуже, чем его отсутствие.
REPLY_TO=
# Чтение входящих. Пусто — выводится из SMTP_HOST заменой smtp. → imap.
IMAP_HOST=
IMAP_PORT=993

# === Аналитика и SEO ===
# Номер счётчика Метрики. Пусто — ни счётчика, ни cookie-баннера.
METRIKA_ID=
GOOGLE_SITE_VERIFICATION=
# Публиковать блог и нишевые лендинги (/blog, /proverka/*).
SEO_ENABLED=false

# === Postgres (подставляется в DATABASE_URL из docker-compose) ===
POSTGRES_PASSWORD=
