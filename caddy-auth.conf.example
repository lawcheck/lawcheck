# Образец файла с кредами basic auth для /stats и /inbox.
#
# На сервере (рядом с docker-compose.yml):
#     cp caddy-auth.conf.example caddy-auth.conf
#     docker run --rm caddy:2-alpine caddy hash-password --plaintext 'НОВЫЙ_ПАРОЛЬ'
#     # вставить полученный хеш ниже, затем:
#     docker compose up -d caddy
#
# Сам caddy-auth.conf в git не попадает (см. .gitignore). Файл ОБЯЗАН
# существовать до `docker compose up`: иначе Docker создаст на его месте
# каталог, и Caddy не стартует — сайт ляжет целиком.

basic_auth {
	maxim ЗАМЕНИТЬ_НА_ХЕШ_ИЗ_caddy_hash-password
}
